{
  "name": "personal-finance-tracking",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @finance/api\" \"npm run dev -w @finance/web\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "npm run db:generate -w @finance/api",
    "db:migrate": "npm run db:migrate -w @finance/api",
    "build": "npm run build -w @finance/web && npm run build -w @finance/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev:demo": "npm run dev:demo -w @finance/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
