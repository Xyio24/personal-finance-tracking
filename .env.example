# Copy to .env and fill in your own values.
# .env is gitignored — real values must NEVER be committed (this repository is public).

# Public URL of the app, without a trailing slash.
#   Development: http://localhost:5173
#   Production:  https://finance.example.com
APP_URL=http://localhost:5173

# Google OAuth client (Google Cloud Console → Google Auth Platform → Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google accounts allowed to log in, comma separated. Everyone else is rejected.
ALLOWED_EMAILS=you@example.com

# ---------- Development only (npm run dev) ----------
DATABASE_URL=postgres://finance:finance@localhost:5433/finance

# ---------- Production only (docker-compose.yml) ----------
# Long random hex string, e.g. the output of: openssl rand -hex 32
POSTGRES_PASSWORD=
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install command token.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional offsite backup (docs/DEPLOY.md → "Backup offsite"). Uncomment once rclone is set up.
# COMPOSE_PROFILES=offsite
# OFFSITE_REMOTE=finance-backup:
# OFFSITE_KEEP_DAYS=90
